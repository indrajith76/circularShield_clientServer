# =============================================================================
# CIRCULARSHIELD ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' (or '.env.local') to configure your local development environment.
# NOTE: In Vite, only variables prefixed with 'VITE_' are exposed to client-side code.
# Never commit real secret keys, private credentials, or production tokens into version control.

# -----------------------------------------------------------------------------
# 1. Backend API Base URL
# -----------------------------------------------------------------------------
# The base URL of your CircularShield backend REST API (without a trailing slash).
# In local development: http://localhost:5000/api
# In staging/production: https://api.yourdomain.com/v1
VITE_API_BASE_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# 2. Network Timeouts
# -----------------------------------------------------------------------------
# Default HTTP request timeout in milliseconds (30,000 ms = 30 seconds)
VITE_API_TIMEOUT_MS=30000

# Extended timeout for AI / OCR / Multimodal Job Circular Analysis requests (60s)
VITE_ANALYSIS_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# 3. File Upload Constraints
# -----------------------------------------------------------------------------
# Maximum allowed file size for job circular PDF / image attachments in bytes
# 10485760 bytes = 10 Megabytes (MB)
VITE_MAX_FILE_SIZE_BYTES=10485760

# -----------------------------------------------------------------------------
# 4. Optional Client Feature Flags
# -----------------------------------------------------------------------------
# Set to 'true' to log outgoing API requests and response timings in browser devtools
VITE_ENABLE_API_LOGGING=false
